#!/usr/bin/env bash
# Runs the offline suite on the working tree and stops the commit if a check fails, printing only the failures and the
# summary, and reminds a commit of a new wiki snapshot to run the live suite by hand (see docs/testing.md).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
if grep -qE '^(wiki-(data|links|navboxes|lead)\.js|.*\.zim\.sha256)$' <<<"$(git diff --cached --name-only)"; then
  echo 'pre-commit: this commit changes the wiki snapshot, so run the live suite (test/run-e2e.sh) by hand too; see docs/wiki-data.md'
fi
echo 'pre-commit: running the offline suite (test/run-e2e.sh --offline)'
# A port of its own, so a live suite running at the same time keeps its Firefox.
out=$(PORT=9335 test/run-e2e.sh --offline 2>&1)
status=$?
if [ "$status" -ne 0 ] && ! grep -q '^FAIL' <<<"$out"; then
  echo "$out"   # it stopped before reporting a check, so show everything
else
  grep '^FAIL' <<<"$out"
  tail -n 1 <<<"$out"
fi
exit "$status"
